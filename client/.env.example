# Client Environment Variables

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase (Phone Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XZY123456

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Adsterra Ad Scripts ───────────────────────────────────────────────────────
# Lấy từ Adsterra dashboard → My Sites → Ad Units → lấy script src
# Để trống = component hiện placeholder (dev mode)
# Banner nhỏ nằm trên player trang xem phim
NEXT_PUBLIC_AD_WATCH_SCRIPT=
# Banner nằm dưới cùng trang home
NEXT_PUBLIC_AD_HOME_SCRIPT=
# Banner giữa trang danh sách / chi tiết phìm (vị trí 1: dưới nội dung)
NEXT_PUBLIC_AD_INLINE_SCRIPT=
# Banner giữa trang danh sách / chi tiết phìm (vị trí 2: giữa phìm liên quan và bình luận)
NEXT_PUBLIC_AD_INLINE2_SCRIPT=
# Overlay interstitial (hiện sau 3 lần chuyển trang, 1 lần/session)
NEXT_PUBLIC_AD_INTERSTITIAL_SCRIPT=
# Pre-roll video ad hiển thị trước khi phim bắt đầu (iframe URL từ Monetag/Adsterra)
# Để trống = không hiện pre-roll; Premium users luôn bỏ qua tự động
NEXT_PUBLIC_AD_PREROLL_URL=
