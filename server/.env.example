PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/myapp
# Atlas:  mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/myapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/myapp

CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_64_chars_here
JWT_EXPIRES_IN=30d

# ── Thanh toán SePay (VietQR) ─────────────────────────────────────────────
# Đăng ký tại: https://sepay.vn
SEPAY_API_KEY=your_sepay_api_key
BANK_CODE=MB
BANK_ACC_NUM=9999999999
BANK_ACC_NAME=NGUYEN VAN A

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Lấy JSON tại: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste toàn bộ JSON lên 1 dòng (xóa newline)
FIREBASE_SERVICE_ACCOUNT=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Đăng ký tại: https://resend.com → lấy API key
RESEND_API_KEY=re_your_resend_api_key
FROM_NAME=YourApp Admin
FROM_EMAIL=no-reply@yourdomain.com

# ── TMDB API ─────────────────────────────────────────────────────────────────
# Đăng ký tại: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Tạo cặp key bằng: node scripts/generate_vapid.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@yourdomain.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email tài khoản được cấp quyền admin khi đăng nhập lần đầu
ADMIN_EMAILS=admin@yourdomain.com

# ── Local Download + Abyss Upload (Premium 4K pipeline) ───────────────────────
# Folder JDownloader lưu file tải về (máy local hoặc VPS nếu bạn tự chạy JD2)
DOWNLOAD_PATH=D:\Download

# MyJDownloader (để server/services/watcherService.js theo dõi package)
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE_NAME=JDownloader@ADMIN

# Abyss / Hydrax Upload
# API key dùng để upload qua https://up.abyss.to/<key>
ABYSS_API_KEY=
# API base dùng để poll status (nếu khác mặc định)
ABYSS_API_URL=https://api.abyss.to/v1
# Embed base đúng theo host bạn đang dùng (ảnh của bạn là https://short.icu/<slug>)
ABYSS_EMBED_BASE=https://short.icu
