PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/myapp
# Atlas:  mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/myapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/myapp

CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_64_chars_here
JWT_EXPIRES_IN=30d

# ── Thanh toán SePay (VietQR) ─────────────────────────────────────────────
# Đăng ký tại: https://sepay.vn
SEPAY_API_KEY=your_sepay_api_key
BANK_CODE=MB
BANK_ACC_NUM=9999999999
BANK_ACC_NAME=NGUYEN VAN A

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Lấy JSON tại: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste toàn bộ JSON lên 1 dòng (xóa newline)
FIREBASE_SERVICE_ACCOUNT=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Đăng ký tại: https://resend.com → lấy API key
RESEND_API_KEY=re_your_resend_api_key
FROM_NAME=YourApp Admin
FROM_EMAIL=no-reply@yourdomain.com

# ── TMDB API ─────────────────────────────────────────────────────────────────
# Đăng ký tại: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Tạo cặp key bằng: node scripts/generate_vapid.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@yourdomain.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email tài khoản được cấp quyền admin khi đăng nhập lần đầu
ADMIN_EMAILS=admin@yourdomain.com
# ── Real-Debrid (Account Pool — phân cách bằng dấu phẩy) ────────────────────
# Tối thiểu 8 tài khoản để có ~12.5TB bandwidth/ngày (đủ cho 200 CCU)
# Mua tại: https://real-debrid.com | Gói 180 ngày = tối ưu chi phí
REAL_DEBRID_API_KEY=rd_key1,rd_key2,rd_key3,rd_key4

# ── AllDebrid (Dự phòng nếu RD đầy tải) ───────────────────────────────────
ALL_DEBRID_API_KEY=ad_key1,ad_key2

# ── Zilean (Torrent Hash Lookup) ─────────────────────────────────────────────
# Self-hosted: https://github.com/iPromKnight/zilean
# Public: https://zilean.elfhosted.com (giới hạn request)
ZILEAN_URL=https://zilean.elfhosted.com

# ── MediaFlow Proxy / Nginx Nodes ────────────────────────────────────────────
# JWT Secret để tạo signed streaming URL (phải giống config trên Nginx/Caddy)
# Tạo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NGINX_JWT_SECRET=your_nginx_jwt_secret_here

# Danh sách Proxy Node URLs phân cách bằng dấu phẩy
# (Fallback khi MongoDB ServerNode collection rỗng)
# Thêm nodes qua Admin Dashboard: POST /api/admin/nodes
NGINX_PROXY_URL=https://node1.yourstream.com,https://node2.yourstream.com

# ── Telegram Alert (Giám sát hệ thống) ──────────────────────────────────────
# Tạo bot: https://t.me/BotFather → lấy token
# Lấy chat_id: gửi tin nhắn bot rồi truy cập https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
